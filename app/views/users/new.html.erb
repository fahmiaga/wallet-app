<h1>New user</h1>
<% if @user.errors.any? %>
  <ul>
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>
<%= form_with url: users_create_path do |form| %>
  <div>
    <%= form.label "user[name]", "Name" %>
    <%= form.text_field "user[name]" %>
  </div>
  <div>
    <%= form.label "user[email]", "Email" %>
    <%= form.text_field "user[email]" %>
  </div>
  <%= form.submit "Create user" %>
<% end %>
